; Calculates the nth fibonacci number
; fib(n) -> x:
;   if n == 0, then return 0
;   if n == 1, then return 1
;   return fib(n-1) + fib(n-2)
; 
; fib(0)  =       0 = 00000000000000000000000000000000
; fib(1)  =       1 = 00000000000000000000000000000001
; fib(2)  =       1 = 00000000000000000000000000000001
; fib(3)  =       2 = 00000000000000000000000000000010
; fib(7)  =      13 = 00000000000000000000000000001101
; fib(9)  =      34 = 00000000000000000000000000100010
; fib(18) =    2584 = 00000000000000000000101000011000
; fib(32) = 2178309 = 00000000001000010011110100000101

ldi 0

fib:







