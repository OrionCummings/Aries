; These are some comments
; to test how well the error
; messages respond to non-code
; lines!

ldi 1 A         ; Load 1 into register A
ldi 4 B         ; Load 4 into register B
add A B C       ; A + B = C
hlt             ; Halt the program

; Expected output
: 00111100 00000000 00000000 00000001
: 00111100 01000000 00000000 00000100
: 00001000 00000100 10000000 00000000
: 00000100 00000000 00000000 00000000