; These are some comments
; to test how well the error
; messages respond to non-code
; lines!

ldi 251 A       ; Load 1 into register A
ldi 4 B         ; Load 4 into register B
add A B C       ; A + B -> C
nop             ; Do nothing!
hlt             ; Halt the program

; Expected output
:b 00111100 00000000 00000000 11111011
:b 00111100 01000000 00000000 00000100
:b 00001000 00000100 10000000 00000000
:b 00000000 00000000 00000000 00000000
:b 00000100 00000000 00000000 00000000
:x 3C 00 00 FB
:x 3C 40 00 04
:x 08 04 80 00
:x 00 00 00 00
:x 04 00 00 00
