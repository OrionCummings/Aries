// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
    {
        "label": "Test",
        "command": "echo '$ZED_WORKTREE_ROOT'",
        "cwd": ""
    },
    {
        "label": "Run",
        "command": "./build/src/AriesCompiler",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Compile & Run Release",
        "command": "cmake -B './build' -S '.' && cmake --build './build' && ./build/src/AriesCompiler && echo",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Compile & Run Debug",
        "command": "cmake -B './build' -S '.' && cmake --build './build' && ./build/src/AriesCompiler && echo",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "Compile & Run Tests",
        "command": "cmake '-DCMAKE_INSTALL_PREFIX=./out/install/Test' -DCMAKE_C_COMPILER=/usr/bin/clang -DCMAKE_BUILD_TYPE=Debug -DTARGET_GROUP=test -S '.' -B './build/Test' && cmake --build './build/Test' --target AriesCompiler test_lexer_lib && ./build/Test/AriesCompiler && echo",
        "cwd": "$ZED_WORKTREE_ROOT"
    },
    {
        "label": "CMake Clean",
        "command": "rm -rf './build' && mkdir './build'", // This sucks lol; idk why rm -rf [...]/build/* isn't working...,
        "cwd": "$ZED_WORKTREE_ROOT"
    }
]
