{
  "name": "airesextension",
  "displayName": "AiresExtension",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "airesextension.helloWorld",
        "title": "Hello World"
      }
    ],
    "iconThemes": [
      {
        "id": "aries_theme",
        "label": "Aires",
        "path": "./fileicons/aries-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "aires_lang",
        "aliases": [
          "Aires"
        ],
        "extensions": [
          "ari",
          "aria"
        ],
        "icon": {
          "dark": "./fileicons/aires-file-icon.svg",
          "light": "./fileicons/aires-file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ]
  },
  
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
